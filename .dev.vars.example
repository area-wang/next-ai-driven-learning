# Cloudflare Workers 本地开发环境变量示例
# 复制此文件为 .dev.vars 并填入实际值

# NextAuth 配置 (必需)
# 生成方法: openssl rand -base64 32
AUTH_SECRET=PMF1RzbEJD4AhM3fLx+5uMuWaRl9Q7J7uCGS0W9+CwQ=
NEXTAUTH_URL=http://localhost:8787

# Google OAuth (可选)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (可选)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudflare R2 配置 (用于文件上传)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.r2.dev

# AI API Keys
# OpenRouter 统一 API Key (推荐 - 支持所有模型)
OPENROUTER_API_KEY=your-openrouter-api-key

# 或者单独配置各厂商 API Key
DEEPSEEK_API_KEY=sk-74fdba8d61504b468194e75797b879d1
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENROUTER_API_KEY=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

# Tavily Search API (用于联网搜索功能)
TAVILY_API_KEY=your-tavily-api-key
